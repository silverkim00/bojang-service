# VCS / tooling
.git/
.gitattributes
.github/
.gcloudignore

# Python
venv/
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.pytest_cache/
.coverage
htmlcov/

# Logs / temp / artifacts
tmp/
*.log
*.zip
*.tar
*.gz
*.xlsx

# Frontend caches
node_modules/
bojang-frontend/node_modules/
bojang-frontend/.vite/
