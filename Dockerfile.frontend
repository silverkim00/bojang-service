# 1단계: Vite 빌드
FROM node:20-alpine AS build
WORKDIR /app

# 의존성 먼저
COPY bojang-frontend/package*.json ./
RUN npm ci

# 소스 복사 후 빌드
COPY bojang-frontend/ .
RUN npm run build

# 2단계: nginx로 정적 파일 서빙
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
